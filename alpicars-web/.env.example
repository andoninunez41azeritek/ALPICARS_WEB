# Copia este archivo como .env.local y rellena los valores (nunca subas .env.local a GitHub)
# Supabase (cuentas de clientes, solicitudes, informes guardados y ofertas). Proyecto: ALPICARS-WEB
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tienda: clave secreta de Stripe (panel de Stripe → Desarrolladores → Claves de API).
# sk_test_... para probar · sk_live_... para cobrar de verdad (cuando AlpiCars esté dada de alta).
STRIPE_SECRET_KEY=

# Pedidos de la tienda (solo servidor, nunca NEXT_PUBLIC_):
# Stripe → Webhooks → endpoint /api/stripe/webhook (evento checkout.session.completed) → Signing secret
STRIPE_WEBHOOK_SECRET=
# Supabase → Project Settings → API Keys → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=
